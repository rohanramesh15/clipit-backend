{
  "manifest_version": 3,
  "name": "ClipIt",
  "version": "1.5.3",
  "description": "Learn languages from YouTube and Netflix videos you love",
  "permissions": ["storage", "scripting", "tabCapture", "offscreen", "activeTab"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://www.netflix.com/watch/*",
    "https://project-deadbird-backend.fly.dev/*",
    "https://clipit-sable.vercel.app/*",
    "https://joinclipit.com/*",
    "https://www.joinclipit.com/*",
    "https://theclipitapp.com/*",
    "https://www.theclipitapp.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:5173/*",
    "http://localhost:5176/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.netflix.com/watch/*"],
      "js": ["netflix-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://clipit-sable.vercel.app/*",
        "https://joinclipit.com/*",
        "https://www.joinclipit.com/*",
        "https://theclipitapp.com/*",
        "https://www.theclipitapp.com/*",
        "http://localhost:5173/*",
        "http://localhost:5176/*"
      ],
      "js": ["token-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClipIt",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["youtube-inject.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
