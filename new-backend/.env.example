# Project Configuration
PROJECT_NAME=FastAPI Backend
VERSION=1.0.0
DESCRIPTION=A FastAPI backend application

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS - Add your frontend URLs here
# ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database Configuration
# Production uses Supabase's Session pooler: it is IPv4-compatible and uses port
# 5432. Do not use the IPv6-only Direct connection or the Transaction pooler on
# port 6543.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local development may instead use the Docker Postgres container:
# DATABASE_URL=postgresql://user:password@localhost/dbname
# DATABASE_URL=sqlite:///./app.db

# Supabase Auth (service-role key is backend-only; never expose or commit it).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security Configuration (uncomment and configure as needed)
# SECRET_KEY=your-secret-key-here-change-this-in-production
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth Configuration
# Get your Client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
